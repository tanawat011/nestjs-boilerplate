# Copy to .env for `bun run start:dev`. Values below are placeholders.

NODE_ENV=development
PORT=3000

# PostgreSQL (docker compose publishes it on 127.0.0.1:15433)
POSTGRES_HOST=localhost
POSTGRES_PORT=15433
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=nestjs
# true = TLS with certificate verification (use it outside local development)
POSTGRES_SSL=false

# JWT: two different random secrets, at least 32 characters each.
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_EXPIRATION_ACCESS_TOKEN=15m
JWT_EXPIRATION_REFRESH_TOKEN=7d

# bcrypt cost (10-15)
BCRYPT_ROUNDS=12

# Comma-separated origins allowed to call the API from a browser.
# Empty = same-origin only. "*" = any origin.
CORS_ORIGINS=
# Express "trust proxy": false, a hop count (1 behind one load balancer),
# or proxy IPs / subnets. Needed for correct client IPs in rate limiting.
TRUST_PROXY=false
# Requests per minute per client: all routes / register, login, refresh
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=10

# Swagger UI at /docs (default: on outside production)
# SWAGGER_ENABLED=false

# Admin connection for the e2e tests (they create and drop their own database)
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:15433/postgres
